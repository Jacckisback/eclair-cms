{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jacckisback/eclair-cms/docs/schemas/theme.schema.json",
  "title": "Manifeste d'un thème Éclair (theme.json, contrat de rendu 1)",
  "type": "object",
  "required": ["schema", "id", "version", "contract"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "eclair-theme/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Identique au nom du dossier site/themes/<id>/." },
    "name": { "type": "string", "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$" },
    "contract": { "type": "integer", "enum": [1], "description": "Contrat de rendu suivi (docs/THEME-CONTRACT.md)." },
    "parent": { "type": "string", "enum": ["eclair", "eclair@1"], "default": "eclair" },
    "description": { "type": "string", "maxLength": 300 },
    "requires": {
      "type": "object", "additionalProperties": false,
      "properties": { "eclair": { "type": "string" }, "php": { "type": "string" } }
    },
    "templates": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["layout", "single", "list", "cards", "product", "products", "404", "extension"] },
      "description": "Gabarits remplacés : fichiers templates/<nom>.php."
    },
    "styles": { "type": "array", "items": { "type": "string", "pattern": "\\.css$" }, "description": "Feuilles ajoutées après le thème de base (256 Ko au plus en tout)." },
    "overrides": {
      "type": "object",
      "propertyNames": { "enum": ["theme.css", "motion.css", "ads.css", "themes/atelier.css", "themes/boutique.css", "themes/contraste.css", "themes/editorial.css", "themes/studio.css"] },
      "additionalProperties": { "type": "string" },
      "description": "Fichiers CSS du noyau remplacés par un fichier du thème."
    },
    "assets": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\.(css|js|svg|png|jpe?g|webp|avif|gif|woff2|ico)$" },
      "description": "Actifs publiés dans site/assets/<id>/ (Themes::asset())."
    },
    "legacy": { "type": "boolean", "description": "Thème créé par la migration depuis une installation 1.x." }
  }
}
