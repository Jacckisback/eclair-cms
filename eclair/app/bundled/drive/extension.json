{
  "schema": "eclair-extension/1",
  "id": "drive",
  "name": "Sauvegardes Google Drive",
  "version": "2.0.0",
  "description": "Envoie automatiquement une sauvegarde de ton site dans ton Google Drive (compte Google nécessaire). La sauvegarde téléchargeable de la page Sécurité fonctionne sans elle.",
  "requires": { "eclair": ">=2.0.0", "php": ">=8.1" },
  "provides": ["backup-destination"],
  "entry": "extension.php",
  "routes": {
    "public": [],
    "admin": [
      { "method": "GET", "path": "", "handler": "page", "right": "security" },
      { "method": "POST", "path": "", "handler": "action", "right": "security" },
      { "method": "POST", "path": "/poll", "handler": "poll", "right": "security" },
      { "method": "POST", "path": "/tick", "handler": "tick", "right": "security" }
    ]
  },
  "data": { "schema": 1 },
  "provenance": { "source": "Éclair CMS (fonction livrée avec le noyau)", "license": "AGPL-3.0-only" }
}
