        "17-team": "<section class=\"team\"><h2 id=\"team\">Notre équipe</h2><div class=\"grid\"><div class=\"feature member\"><picture><source type=\"image/webp\" srcset=\"/media/2026/10/capture-480.webp 480w, /media/2026/10/capture-800.webp 800w, /media/2026/10/capture-1200.webp 1200w\" sizes=\"8rem\"><img src=\"/media/2026/10/capture.jpg\" alt=\"Image de démonstration\" width=\"1200\" height=\"800\" loading=\"lazy\" decoding=\"async\"></picture><h3>Léa Martin</h3><p class=\"member-role\">Fondatrice</p><p>Une <strong>bio</strong>.</p><p class=\"member-link\"><a href=\"https://www.linkedin.com/in/lea\">linkedin.com ↗</a></p></div><div class=\"feature member\"><span class=\"member-initials\" aria-hidden=\"true\">JD</span><h3>Jean Dupont</h3></div></div></section>\n",
        "18-posts": "<section class=\"posts-block\"><h2>Derniers articles</h2><div class=\"cards\">\n    <article class=\"card\">\n        <div class=\"card-body\">\n      <p class=\"card-meta\">\n        <a class=\"chip\" href=\"/blog/guides\">Guides</a>                  <time datetime=\"2026-10-31T18:25:04+00:00\">31 octobre 2026</time>\n              </p>\n      <h3 class=\"card-title\"><a href=\"/blog/premiers-pas-avec-eclair\">Premiers pas avec Éclair : le guide en 5 minutes</a></h3>\n      <p class=\"card-excerpt\">Découvre comment écrire, structurer et publier un contenu optimisé pour Google et les IA avec Éclair, le CMS ultra léger sans base de données.</p>    </div>\n  </article>\n</div>\n<p class=\"more\"><a href=\"/blog\">Voir tous les articles →</a></p></section>\n",
        "19-products": "<section class=\"posts-block products-block\"><h2 id=\"boutique\">Boutique</h2><div class=\"cards products\">\n    <article class=\"card product-card\">\n          <div class=\"card-img\"><picture><source type=\"image/webp\" srcset=\"/media/2026/10/capture-480.webp 480w, /media/2026/10/capture-800.webp 800w, /media/2026/10/capture-1200.webp 1200w\" sizes=\"(min-width: 72rem) 17rem, (min-width: 40rem) 30vw, 50vw\"><img src=\"/media/2026/10/capture.jpg\" alt=\"\" width=\"1200\" height=\"800\" loading=\"lazy\" decoding=\"async\"></picture></div>\n        <div class=\"card-body\">\n      <h3 class=\"card-title\"><a href=\"/boutique/bol-en-gres-emaille\">Bol en grès émaillé</a></h3>\n      <p class=\"card-price\">\n        <span class=\"price-now\">29,90 €</span>        <s class=\"price-was\"><span class=\"sr-only\">Prix habituel : </span>39 €</s>        <span class=\"badge badge-sale\">Promo</span>      </p>\n    </div>\n  </article>\n    <article class=\"card product-card\">\n        <div class=\"card-body\">\n      <h3 class=\"card-title\"><a href=\"/boutique/tasse-a-cafe\">Tasse à café</a></h3>\n      <p class=\"card-price\">\n        <span class=\"price-now\">18 €</span>                      </p>\n    </div>\n  </article>\n</div>\n<p class=\"more\"><a href=\"/boutique\">Voir toute la boutique →</a></p></section>\n",
