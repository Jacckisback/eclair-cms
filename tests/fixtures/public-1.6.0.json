    "blocks": {
        "0-hero": "<section class=\"hero hero-media\"><div class=\"hero-text\"><h2 class=\"hero-title\">Bandeau de démonstration</h2><p class=\"hero-lead\">Un <strong>texte</strong> d’accroche avec <a href=\"/contact\">un lien</a>.</p><p class=\"btns\"><a class=\"btn btn-primary btn-lg\" href=\"/contact\">Nous écrire</a><a class=\"btn btn-secondary btn-lg\" href=\"/a-propos\">En savoir plus</a></p></div><div class=\"hero-img\"><picture><source type=\"image/webp\" srcset=\"/media/2026/10/capture-480.webp 480w, /media/2026/10/capture-800.webp 800w, /media/2026/10/capture-1200.webp 1200w\" sizes=\"(min-width: 60rem) 34rem, 100vw\"><img src=\"/media/2026/10/capture.jpg\" alt=\"Image de démonstration\" width=\"1200\" height=\"800\" fetchpriority=\"high\" decoding=\"async\"></picture></div></section>\n",
